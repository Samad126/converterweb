{
    "permissions": {
        "allow": [
            "Bash(npm run typecheck)",
            "Bash(npm run lint)",
            "Bash(npm test)",
            "Bash(npx vitest run:*)",
            "Bash(npx tsc --noEmit)"
        ],
        "deny": [
            "Read(./.env)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.mjs\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.mjs\"",
                        "timeout": 120
                    }
                ]
            }
        ]
    }
}
